{
  "apiName": "OneOverlay",
  "label": "One-Overlay",
  "category": "Layout",
  "description": "Universal Overlay component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 7,
  "scope": "platform-core",
  "jsxFile": "one/OneOverlay/OneOverlay.jsx",
  "cssFile": "one/OneOverlay/OneOverlay.css",
  "resize": {
    "defaultWidth": 560,
    "defaultHeight": 260,
    "minWidth": 140,
    "minHeight": 70
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Overlay",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Overlay",
          "label": "One-Overlay"
        }
      ]
    },
    {
      "propertyKey": "title",
      "label": "Title",
      "kind": "TEXT",
      "displayOrder": 300,
      "defaultValue": "Dialog"
    },
    {
      "propertyKey": "openLabel",
      "label": "Open button",
      "kind": "TEXT",
      "displayOrder": 310,
      "defaultValue": "Open"
    },
    {
      "propertyKey": "mode",
      "label": "Mode",
      "kind": "SELECT",
      "displayOrder": 320,
      "defaultValue": "modal",
      "choices": [
        {
          "key": "modal",
          "label": "Modal"
        },
        {
          "key": "drawer",
          "label": "Drawer"
        },
        {
          "key": "popover",
          "label": "Popover"
        }
      ]
    },
    {
      "propertyKey": "openOnFilterKey",
      "label": "Open when sibling selects a record (shared state key)",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 330
    },
    {
      "propertyKey": "hideTrigger",
      "label": "Hide standalone Open button",
      "kind": "BOOLEAN",
      "defaultValue": false,
      "displayOrder": 340
    },
    {
      "propertyKey": "showSelectedRecord",
      "label": "Display currently selected record",
      "kind": "BOOLEAN",
      "defaultValue": false,
      "displayOrder": 400
    },
    {
      "propertyKey": "selectedTitleFieldApiName",
      "label": "Selected record title field",
      "kind": "OBJECT_FIELD",
      "defaultValue": "",
      "displayOrder": 410
    },
    {
      "propertyKey": "selectedImageFieldApiName",
      "label": "Selected record image field",
      "kind": "OBJECT_FIELD",
      "defaultValue": "",
      "displayOrder": 420
    },
    {
      "propertyKey": "imageHeight",
      "label": "Selected image maximum height (px)",
      "kind": "NUMBER",
      "defaultValue": 280,
      "displayOrder": 425
    },
    {
      "propertyKey": "imageFit",
      "label": "Selected image fit",
      "kind": "SELECT",
      "defaultValue": "contain",
      "displayOrder": 426,
      "choices": [
        { "key": "contain", "label": "Contain" },
        { "key": "cover", "label": "Cover" },
        { "key": "fill", "label": "Fill" },
        { "key": "scale-down", "label": "Scale down" }
      ]
    },
    {
      "propertyKey": "imageAspectRatio",
      "label": "Selected image aspect ratio",
      "kind": "SELECT",
      "displayOrder": 427,
      "choices": [
        { "key": "1/1", "label": "1:1" },
        { "key": "4/3", "label": "4:3" },
        { "key": "16/9", "label": "16:9" },
        { "key": "3/4", "label": "3:4" }
      ]
    },
    {
      "propertyKey": "selectedDescriptionFieldApiName",
      "label": "Selected record description field",
      "kind": "OBJECT_FIELD",
      "defaultValue": "",
      "displayOrder": 430
    },
    {
      "propertyKey": "selectedPriceFieldApiName",
      "label": "Selected record price field",
      "kind": "OBJECT_FIELD",
      "defaultValue": "",
      "displayOrder": 440
    },
    {
      "propertyKey": "currencyCode",
      "label": "Selected record price currency",
      "kind": "TEXT",
      "defaultValue": "GBP",
      "displayOrder": 450
    },
    {
      "propertyKey": "cartTargetKey",
      "label": "Shared cart target key",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 460
    },
    {
      "propertyKey": "confirmBehavior",
      "label": "Confirm action",
      "kind": "SELECT",
      "defaultValue": "none",
      "displayOrder": 470,
      "choices": [
        {
          "key": "none",
          "label": "none"
        },
        {
          "key": "add",
          "label": "add"
        },
        {
          "key": "flow",
          "label": "flow"
        }
      ]
    },
    {
      "propertyKey": "confirmLabel",
      "label": "Confirm button text",
      "kind": "TEXT",
      "defaultValue": "Add to basket",
      "displayOrder": 480
    }
  ]
}
