      "choices": [
        {
          "key": "Navigation",
          "label": "One-Navigation"
        }
      ]
    },
    {
      "propertyKey": "orientation",
      "label": "Orientation",
      "kind": "SELECT",
      "displayOrder": 300,
      "defaultValue": "horizontal",
      "choices": [
        {
          "key": "horizontal",
          "label": "Horizontal"
        },
        {
          "key": "vertical",
          "label": "Vertical"
        }
      ]
    }
  ]
