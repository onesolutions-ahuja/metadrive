{
  "apiName": "OneNavigation",
  "label": "One-Navigation",
  "category": "Actions",
  "description": "Universal Navigation component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 2,
  "scope": "platform-core",
  "jsxFile": "one/OneNavigation/OneNavigation.jsx",
  "cssFile": "one/OneNavigation/OneNavigation.css",
  "resize": {
    "defaultWidth": 360,
    "defaultHeight": 100,
    "minWidth": 90,
    "minHeight": 40
