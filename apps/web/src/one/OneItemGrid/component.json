{
  "apiName": "OneItemGrid",
  "label": "One-Item-Grid",
  "category": "Data",
  "description": "Universal ItemGrid component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 14,
  "scope": "platform-core",
  "jsxFile": "one/OneItemGrid/OneItemGrid.jsx",
  "cssFile": "one/OneItemGrid/OneItemGrid.css",
  "resize": {
    "defaultWidth": 660,
    "defaultHeight": 360,
    "minWidth": 240,
    "minHeight": 120
  },
  "propertyDefinitions": [
