{
  "apiName": "OneInput",
  "label": "One-Input",
  "category": "Inputs",
  "description": "Universal Input component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 3,
  "scope": "platform-core",
  "jsxFile": "one/OneInput/OneInput.jsx",
