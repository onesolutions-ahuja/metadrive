        {
          "key": "text",
          "label": "Text"
        },
        {
          "key": "email",
          "label": "Email"
        },
        {
          "key": "password",
          "label": "Password"
        },
        {
          "key": "number",
          "label": "Number"
        },
        {
          "key": "currency",
          "label": "Currency"
        },
        {
          "key": "percent",
          "label": "Percent"
        },
        {
          "key": "date",
          "label": "Date"
        },
        {
          "key": "time",
          "label": "Time"
        },
        {
          "key": "datetime-local",
          "label": "Datetime-Local"
        },
        {
          "key": "tel",
          "label": "Tel"
        },
        {
          "key": "url",
          "label": "Url"
        },
        {
          "key": "search",
          "label": "Search"
        },
        {
          "key": "barcode",
          "label": "Barcode"
        }
