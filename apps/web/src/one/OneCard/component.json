{
  "apiName": "OneCard",
  "label": "One-Card",
  "category": "Layout",
  "description": "Universal Card component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 6,
  "scope": "platform-core",
  "jsxFile": "one/OneCard/OneCard.jsx",
  "cssFile": "one/OneCard/OneCard.css",
  "resize": {
    "defaultWidth": 560,
    "defaultHeight": 260,
    "minWidth": 140,
    "minHeight": 70
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Card",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Card",
          "label": "One-Card"
        }
      ]
    },
    {
      "propertyKey": "title",
      "label": "Title",
      "kind": "TEXT",
      "displayOrder": 300,
      "defaultValue": "Card"
    },
    {
      "propertyKey": "subtitle",
      "label": "Subtitle",
      "kind": "TEXT",
      "displayOrder": 310,
      "defaultValue": ""
    },
    {
      "propertyKey": "description",
      "label": "Description",
      "kind": "TEXT",
      "displayOrder": 320,
      "defaultValue": ""
    },
    {
      "propertyKey": "layoutContainer",
      "label": "Accept nested components",
      "kind": "BOOLEAN",
      "defaultValue": true,
      "displayOrder": 390
    },
    {
      "propertyKey": "imageSrc",
      "label": "Banner image",
      "kind": "IMAGE",
      "defaultValue": "",
      "displayOrder": 325
    },
    {
      "propertyKey": "imageAlt",
      "label": "Banner image alternative text",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 326
    },
    {
      "propertyKey": "imagePosition",
      "label": "Image placement",
      "kind": "SELECT",
      "defaultValue": "right",
      "displayOrder": 327,
      "choices": [
        {
          "key": "right",
          "label": "right"
        },
        {
          "key": "left",
          "label": "left"
        }
      ]
    },
    {
      "propertyKey": "imageWidthPercent",
      "label": "Image width (% of banner)",
      "kind": "NUMBER",
      "defaultValue": 46,
      "displayOrder": 328
    },
    {
      "propertyKey": "imageFit",
      "label": "Banner image fit",
      "kind": "SELECT",
      "defaultValue": "contain",
      "displayOrder": 328.5,
      "choices": [
        { "key": "contain", "label": "Contain" },
        { "key": "cover", "label": "Cover" },
        { "key": "fill", "label": "Fill" },
        { "key": "scale-down", "label": "Scale down" }
      ]
    },
    {
      "propertyKey": "showSurface",
      "label": "Show default card surface",
      "kind": "BOOLEAN",
      "defaultValue": true,
      "displayOrder": 329
    },
    {
      "propertyKey": "showHeading",
      "label": "Show card heading",
      "kind": "BOOLEAN",
      "defaultValue": true,
      "displayOrder": 330
    }
  ]
}
