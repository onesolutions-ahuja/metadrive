{
  "apiName": "OneImage",
  "label": "One-Image",
  "category": "Display",
  "description": "Universal Image component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 5,
  "scope": "platform-core",
  "jsxFile": "one/OneImage/OneImage.jsx",
  "cssFile": "one/OneImage/OneImage.css",
  "resize": {
    "defaultWidth": 360,
    "defaultHeight": 100,
    "minWidth": 90,
    "minHeight": 40
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Image",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Image",
          "label": "One-Image"
        }
      ]
    },
    {
      "propertyKey": "src",
      "label": "Image URL",
      "kind": "IMAGE",
      "displayOrder": 300,
      "defaultValue": ""
    },
    {
      "propertyKey": "alt",
      "label": "Alternative text",
      "kind": "TEXT",
      "displayOrder": 310,
      "defaultValue": ""
    },
    {
      "propertyKey": "imageHeight",
      "label": "Image height (px)",
      "kind": "NUMBER",
      "displayOrder": 320
    },
    {
      "propertyKey": "imageFit",
      "label": "Image fit",
      "kind": "SELECT",
      "displayOrder": 330,
      "defaultValue": "contain",
      "choices": [
        { "key": "contain", "label": "Contain" },
        { "key": "cover", "label": "Cover" },
        { "key": "fill", "label": "Fill" },
        { "key": "scale-down", "label": "Scale down" }
      ]
    },
    {
      "propertyKey": "imageAspectRatio",
      "label": "Image aspect ratio",
      "kind": "SELECT",
      "displayOrder": 340,
      "choices": [
        { "key": "auto", "label": "Auto" },
        { "key": "1/1", "label": "1:1" },
        { "key": "4/3", "label": "4:3" },
        { "key": "16/9", "label": "16:9" },
        { "key": "3/4", "label": "3:4" }
      ]
    }
  ]
}
