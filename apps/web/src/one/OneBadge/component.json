      "kind": "SELECT",
      "displayOrder": 310,
      "defaultValue": "neutral",
      "choices": [
        {
          "key": "neutral",
          "label": "Neutral"
        },
        {
          "key": "success",
          "label": "Success"
        },
        {
          "key": "warning",
          "label": "Warning"
        },
        {
          "key": "danger",
          "label": "Danger"
        }
      ]
    }
