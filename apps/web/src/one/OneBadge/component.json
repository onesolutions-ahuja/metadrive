{
  "apiName": "OneBadge",
  "label": "One-Badge",
  "category": "Display",
  "description": "Universal Badge component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 2,
  "scope": "platform-core",
  "jsxFile": "one/OneBadge/OneBadge.jsx",
  "cssFile": "one/OneBadge/OneBadge.css",
  "resize": {
    "defaultWidth": 360,
    "defaultHeight": 100,
    "minWidth": 90,
    "minHeight": 40
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
