{
  "apiName": "OneTable",
  "label": "One-Table",
  "category": "Data",
  "description": "Universal Table component with configurable record columns and row-scoped Flow action buttons.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 3,
  "scope": "platform-core",
  "jsxFile": "one/OneTable/OneTable.jsx",
  "cssFile": "one/OneTable/OneTable.css",
  "resize": {
    "defaultWidth": 660,
    "defaultHeight": 360,
    "minWidth": 240,
    "minHeight": 120
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Table",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Table",
          "label": "One-Table"
        }
      ]
    },
    {
      "propertyKey": "pageSize",
      "label": "Rows per page",
      "kind": "NUMBER",
      "displayOrder": 300,
      "defaultValue": 25
    },
    {
      "propertyKey": "striped",
      "label": "Striped rows",
      "kind": "BOOLEAN",
      "displayOrder": 310,
      "defaultValue": false
    }
  ]
}
