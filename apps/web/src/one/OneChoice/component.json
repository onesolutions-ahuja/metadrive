{
  "apiName": "OneChoice",
  "label": "One-Choice",
  "category": "Inputs",
  "description": "Universal Choice component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 3,
  "scope": "platform-core",
  "jsxFile": "one/OneChoice/OneChoice.jsx",
  "cssFile": "one/OneChoice/OneChoice.css",
  "resize": {
    "defaultWidth": 360,
    "defaultHeight": 100,
    "minWidth": 90,
    "minHeight": 40
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Choice",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Choice",
          "label": "One-Choice"
        }
      ]
    },
    {
      "propertyKey": "label",
      "label": "Field label",
      "kind": "TEXT",
      "displayOrder": 300,
      "defaultValue": "Choose"
    },
    {
      "propertyKey": "mode",
      "label": "Mode",
      "kind": "SELECT",
      "displayOrder": 310,
      "defaultValue": "select",
      "choices": [
        {
          "key": "select",
          "label": "Select"
        },
        {
          "key": "multiple",
          "label": "Multiple"
        },
        {
          "key": "radio",
          "label": "Radio"
        },
        {
          "key": "checkbox",
          "label": "Checkbox"
        },
        {
          "key": "segmented",
          "label": "Segmented"
        }
      ]
    },
    {
      "propertyKey": "optionSource",
      "label": "Choice source",
      "kind": "SELECT",
      "displayOrder": 320,
      "defaultValue": "static",
      "choices": [
        { "key": "static", "label": "Options configured on component" },
        { "key": "records", "label": "Bound Object records" }
      ]
    },
    {
      "propertyKey": "optionLabelFieldApiName",
      "label": "Record option label field",
      "kind": "OBJECT_FIELD",
      "displayOrder": 330,
      "defaultValue": ""
    },
    {
      "propertyKey": "optionValueFieldApiName",
      "label": "Record option value field",
      "kind": "TEXT",
      "displayOrder": 340,
      "defaultValue": "Id"
    },
    {
      "propertyKey": "optionPriceFieldApiName",
      "label": "Optional displayed price field",
      "kind": "OBJECT_FIELD",
      "displayOrder": 350,
      "defaultValue": ""
    },
    {
      "propertyKey": "optionAvailableFieldApiName",
      "label": "Optional availability checkbox field",
      "kind": "OBJECT_FIELD",
      "displayOrder": 360,
      "defaultValue": ""
    },
    {
      "propertyKey": "currencyCode",
      "label": "Price display currency",
      "kind": "TEXT",
      "displayOrder": 370,
      "defaultValue": ""
    },
    {
      "propertyKey": "minSelections",
      "label": "Minimum selections (Flow must enforce)",
      "kind": "NUMBER",
      "displayOrder": 380,
      "defaultValue": 0
    },
    {
      "propertyKey": "maxSelections",
      "label": "Maximum selections (Flow must enforce)",
      "kind": "NUMBER",
      "displayOrder": 390,
      "defaultValue": 0
    }
  ]
}
