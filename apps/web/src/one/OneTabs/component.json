{
  "apiName": "OneTabs",
  "label": "One-Tabs",
  "category": "Layout",
  "description": "Universal Tabs component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 7,
  "scope": "platform-core",
  "jsxFile": "one/OneTabs/OneTabs.jsx",
  "cssFile": "one/OneTabs/OneTabs.css",
  "resize": {
    "defaultWidth": 560,
    "defaultHeight": 260,
    "minWidth": 140,
    "minHeight": 70
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Tabs",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Tabs",
          "label": "One-Tabs"
        }
      ]
    },
    {
      "propertyKey": "tabs",
      "label": "Tabs comma-separated",
      "kind": "TEXT",
      "displayOrder": 300,
      "defaultValue": "Overview,Details"
    },
    {
      "propertyKey": "dynamicTabs",
      "label": "Load tab labels from bound records",
      "kind": "BOOLEAN",
      "defaultValue": false,
      "displayOrder": 320
    },
    {
      "propertyKey": "categoryFieldApiName",
      "label": "Category field API name",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 330
    },
    {
      "propertyKey": "filterKey",
      "label": "Shared filter key",
      "kind": "TEXT",
      "defaultValue": "category",
      "displayOrder": 370
    },
    {
      "propertyKey": "categoryValueFieldApiName",
      "label": "Category record value field",
      "kind": "TEXT",
      "defaultValue": "Id",
      "displayOrder": 355
    },
    {
      "propertyKey": "showPanel",
      "label": "Show tab content panel",
      "kind": "BOOLEAN",
      "defaultValue": true,
      "displayOrder": 380
    },
    {
      "propertyKey": "tabStyle",
      "label": "Tab display style",
      "kind": "SELECT",
      "defaultValue": "default",
      "displayOrder": 381,
      "choices": [
        {
          "key": "default",
          "label": "default"
        },
        {
          "key": "pill",
          "label": "pill"
        }
      ]
    },
    {
      "propertyKey": "showAllTab",
      "label": "Show All tab",
      "kind": "BOOLEAN",
      "defaultValue": false,
      "displayOrder": 382
    },
    {
      "propertyKey": "allTabLabel",
      "label": "All tab label",
      "kind": "TEXT",
      "defaultValue": "All",
      "displayOrder": 383
    },
    {
      "propertyKey": "wrapTabs",
      "label": "Wrap tabs onto new rows",
      "kind": "BOOLEAN",
      "defaultValue": true,
      "displayOrder": 384
    },
    {
      "propertyKey": "relatedFilterKey",
      "label": "Selected parent shared key",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 720
    },
    {
      "propertyKey": "relatedFieldApiName",
      "label": "Lookup field linking tab to parent",
      "kind": "OBJECT_FIELD",
      "defaultValue": "",
      "displayOrder": 730
    }
  ]
}
