{
  "apiName": "OneTabs",
  "label": "One-Tabs",
  "category": "Layout",
  "description": "Universal Tabs component; metadata-configured presentation, data and events.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 6,
  "scope": "platform-core",
  "jsxFile": "one/OneTabs/OneTabs.jsx",
  "cssFile": "one/OneTabs/OneTabs.css",
  "resize": {
    "defaultWidth": 560,
    "defaultHeight": 260,
    "minWidth": 140,
    "minHeight": 70
  },
  "propertyDefinitions": [
    {
      "propertyKey": "kind",
      "label": "Component kind",
      "kind": "SELECT",
      "required": true,
      "defaultValue": "Tabs",
      "displayOrder": 0,
      "choices": [
        {
          "key": "Tabs",
          "label": "One-Tabs"
        }
      ]
    },
    {
      "propertyKey": "tabs",
      "label": "Tabs comma-separated",
      "kind": "TEXT",
      "displayOrder": 300,
      "defaultValue": "Overview,Details"
    },
    {
      "propertyKey": "dynamicTabs",
      "label": "Load tab labels from bound records",
      "kind": "BOOLEAN",
      "defaultValue": false,
      "displayOrder": 320
    },
    {
      "propertyKey": "categoryFieldApiName",
      "label": "Category field API name",
      "kind": "TEXT",
      "defaultValue": "",
      "displayOrder": 330
    },
    {
      "propertyKey": "filterKey",
      "label": "Shared filter key",
      "kind": "TEXT",
      "defaultValue": "category",
      "displayOrder": 370
    },
    {
      "propertyKey": "categoryValueFieldApiName",
      "label": "Category record value field",
      "kind": "TEXT",
      "defaultValue": "Id",
      "displayOrder": 355
    }
  ]
}
