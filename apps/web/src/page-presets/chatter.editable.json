{
  "apiName": "UNE_CHATTER",
  "label": "Chatter",
  "targetObject": "Communication_Records__c",
  "pageType": "App Page",
  "layoutMode": "template",
  "canvasWidth": 1200,
  "canvasHeight": 800,
  "status": "Draft",
  "devices": [
    "Desktop",
    "Phone"
  ],
  "components": [
    {
      "id": "chatter-inbox",
      "type": "Custom:ChatterInbox",
      "label": "Chatter Inbox",
      "region": "main",
      "visible": true,
      "properties": {
        "libraryComponentId": "ChatterInbox",
        "title": "Chatter",
        "accentColor": "#168657",
        "conversationsObjectApiName": "Communication_Records__c",
        "messagesObjectApiName": "Communication_Records__c",
        "channelAccountObjectApiName": "Connector_App__c",
        "restrictToAssigned": false,
        "enableAssignment": true,
        "actionFlows": {
          "send": {
            "flowApiName": "CHATTER_SEND_MESSAGE",
            "inputs": {
              "ConversationId": "$event.conversationId",
              "ChannelAccountId": "$event.channelAccountId",
              "RecipientPhone": "$event.recipientPhone",
              "Body": "$event.body"
            }
          },
          "assign": {
            "flowApiName": "CHATTER_ASSIGN_CONVERSATION",
            "inputs": {
              "ConversationId": "$event.conversationId",
              "ChannelAccountId": "$event.channelAccountId"
            }
          }
        },
        "objectApiName": "Communication_Records__c"
      }
    }
  ],
  "activationAssignments": [],
  "template": "one-region"
}
