    "pg": "^8.13.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "sanitize-html": "^2.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.20.0",
