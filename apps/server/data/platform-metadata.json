  "flows": [
    {
      "apiName": "Renewal_Risk_Evaluation",
      "label": "Renewal Risk Evaluation",
      "flowType": "Record-Triggered Flow",
      "status": "Draft",
      "triggerObject": "Renewal__c",
      "elements": [
        {
          "id": 1,
          "type": "Start",
          "label": "Record-Triggered Flow",
          "config": {
            "trigger": "created-or-updated",
            "runWhen": "after-save"
          }
        },
        {
          "id": 2,
          "type": "Decision",
          "label": "Renewal at risk?",
          "config": {
            "outcomes": [
              {
                "name": "At_Risk",
                "label": "At Risk"
              },
              {
                "name": "Default",
                "label": "Default Outcome"
              }
            ]
          }
        },
        {
          "id": 3,
          "type": "Update Records",
          "label": "Update Renewal Status",
          "config": {
            "object": "Renewal__c",
            "field": "Status__c",
            "value": "At Risk"
          }
        }
      ],
      "connectors": [
        {
          "from": 1,
          "to": 2,
          "label": ""
        },
        {
          "from": 2,
          "to": 3,
          "label": "At Risk"
        }
      ]
    }
  ],
