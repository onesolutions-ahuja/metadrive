        {
          "apiName": "CHATTER_ASSIGN_CONVERSATION",
          "label": "Chatter Assign Conversation",
          "description": "Editable metadata-driven Chatter Flow. Server channel grant and credential binding enforced before execution.",
          "flowType": "Autolaunched Flow",
          "status": "Draft",
          "versionNumber": 1,
          "activeVersion": null,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Start",
              "config": {}
            },
            {
              "id": 2,
              "type": "Update Records",
              "label": "Assign Authorized Conversation",
              "config": {
                "object": "Communication_Records__c",
                "conditions": [
                  {
                    "field": "Chatter_Conversation_Id__c",
                    "operator": "Equals",
                    "value": "{!ConversationId}"
                  }
                ],
                "fieldValues": [
