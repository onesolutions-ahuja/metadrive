          "components": [
            {
              "id": "chatter-inbox",
              "type": "Custom:ChatterInbox",
              "label": "Chatter Inbox",
              "region": "main",
              "visible": true,
              "properties": {
                "libraryComponentId": "ChatterInbox",
                "title": "Chatter",
                "accentColor": "#168657",
                "conversationsObjectApiName": "Communication_Records__c",
                "messagesObjectApiName": "Communication_Records__c",
                "channelAccountObjectApiName": "Connector_App__c",
                "restrictToAssigned": false,
                "enableAssignment": true,
                "actionFlows": {
                  "send": {
                    "flowApiName": "CHATTER_SEND_MESSAGE",
                    "inputs": {
                      "ConversationId": "$event.conversationId",
                      "ChannelAccountId": "$event.channelAccountId",
                      "RecipientPhone": "$event.recipientPhone",
                      "Body": "$event.body"
                    }
                  },
                  "assign": {
                    "flowApiName": "CHATTER_ASSIGN_CONVERSATION",
                    "inputs": {
                      "ConversationId": "$event.conversationId",
                      "ChannelAccountId": "$event.channelAccountId"
                    }
                  }
                }
              }
            }
          ],
          "activationAssignments": [],
          "template": "one-region"
        }
      ],
      "flows": [
        {
          "apiName": "CHATTER_SEND_MESSAGE",
          "label": "Chatter Send WhatsApp Message",
          "description": "Editable metadata-driven Chatter Flow. Server channel grant and credential binding enforced before execution.",
          "flowType": "Autolaunched Flow",
          "status": "Draft",
          "versionNumber": 1,
          "activeVersion": null,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Start",
              "config": {}
            },
            {
              "id": 2,
              "type": "HTTP Callout",
              "label": "WhatsApp Cloud Send",
              "config": {
                "namedCredentialResource": "{!CredentialId}",
                "method": "POST",
                "path": "{!PhoneNumberId}/messages",
                "headers": "Content-Type: application/json",
                "body": "{\"messaging_product\":\"whatsapp\",\"to\":\"{!RecipientPhone}\",\"type\":\"text\",\"text\":{\"body\":\"{!Body}\"}}",
                "deliveryMode": "SYNC",
                "onError": "FAIL",
                "statusVariable": "ProviderStatus"
              }
            },
            {
              "id": 3,
              "type": "Create Records",
              "label": "Record Sent Message",
              "config": {
                "object": "Communication_Records__c",
                "fieldValues": [
                  {
                    "field": "Name",
                    "value": "Chatter outgoing"
                  },
                  {
                    "field": "Event_Type__c",
                    "value": "Message"
                  },
                  {
                    "field": "Communication_Mode__c",
                    "value": "WhatsApp"
                  },
                  {
                    "field": "Source__c",
                    "value": "Flow"
                  },
                  {
                    "field": "Direction__c",
                    "value": "Outgoing"
                  },
                  {
                    "field": "From_Number__c",
                    "value": "{!SenderNumber}"
                  },
                  {
                    "field": "To_Number__c",
                    "value": "{!RecipientPhone}"
                  },
                  {
                    "field": "Channel_Account__c",
                    "value": "{!ChannelAccountId}"
                  },
                  {
                    "field": "Chatter_Conversation_Id__c",
                    "value": "{!ConversationId}"
                  },
                  {
                    "field": "Message_Body__c",
                    "value": "{!Body}"
                  },
                  {
                    "field": "Status__c",
                    "value": "Completed"
                  },
                  {
                    "field": "Occurred_At__c",
                    "value": "{!$Flow.CurrentDateTime}"
                  }
                ]
              }
            },
            {
              "id": 4,
              "type": "End",
              "label": "End",
              "config": {}
            }
          ],
          "connectors": [
            {
              "id": "chatter-1",
              "from": 1,
