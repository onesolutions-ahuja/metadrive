      "flows": [
        {
          "apiName": "KIOSK_SESSION_START",
          "label": "Kiosk - Start session",
          "description": "Editable metadata Flow; uses record permissions and tenant objects",
          "flowType": "Autolaunched Flow",
          "status": "Active",
          "versionNumber": 1,
          "activeVersion": null,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Start",
              "config": {}
            },
            {
              "id": 2,
              "type": "Get Records",
              "label": "Find session",
              "config": {
                "object": "Cart__c",
                "conditions": [
                  {
                    "field": "Session__c",
                    "operator": "Equals",
                    "value": "{!SessionId}"
                  }
                ],
                "outputVariable": "CartHeader"
              }
            },
            {
              "id": 3,
              "type": "Decision",
              "label": "Create session if missing",
              "config": {
                "outcomes": [
                  {
                    "name": "Missing",
                    "label": "Missing",
                    "conditions": [
                      {
                        "field": "{!CartHeader.Id}",
                        "operator": "Is Null"
                      }
                    ]
                  },
                  {
                    "name": "Default",
                    "label": "Default Outcome",
                    "conditions": []
                  }
                ]
              }
            },
            {
              "id": 4,
              "type": "Create Records",
              "label": "Create session header",
              "config": {
                "object": "Cart__c",
                "fieldValues": [
                  {
                    "field": "Name",
                    "value": "Kiosk Cart"
                  },
                  {
                    "field": "Session__c",
                    "value": "{!SessionId}"
                  },
                  {
                    "field": "Status__c",
                    "value": "Open"
                  }
                ]
              }
            },
            {
              "id": 5,
              "type": "End",
              "label": "End",
              "config": {}
            }
          ],
          "connectors": [
            {
              "id": "kiosk-1-2-next",
              "from": 1,
              "to": 2,
              "label": "",
              "kind": "normal"
            },
            {
              "id": "kiosk-2-3-next",
              "from": 2,
              "to": 3,
              "label": "",
              "kind": "normal"
            },
            {
              "id": "kiosk-3-4-Missing",
              "from": 3,
              "to": 4,
              "label": "Missing",
              "kind": "normal"
            },
            {
              "id": "kiosk-3-5-Default Outcome",
              "from": 3,
              "to": 5,
              "label": "Default Outcome",
              "kind": "normal"
            },
            {
              "id": "kiosk-4-5-next",
              "from": 4,
              "to": 5,
              "label": "",
              "kind": "normal"
            }
          ],
