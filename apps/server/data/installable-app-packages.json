        {
          "apiName": "UNE_CHATTER",
          "label": "Chatter",
          "targetObject": "Communication_Records__c",
          "pageType": "Record Page",
          "layoutMode": "free-canvas",
          "canvasWidth": 1200,
          "canvasHeight": 800,
          "status": "Active",
          "devices": [
            "Desktop",
            "Phone"
          ],
          "components": [
            {
              "id": "chatter-inbox",
              "type": "Custom:ChatterInbox",
              "label": "Chatter Inbox",
              "region": "main",
              "visible": true,
              "position": {
                "x": 0,
                "y": 0,
                "width": 1200,
                "height": 800
              },
              "properties": {
                "libraryComponentId": "ChatterInbox",
                "title": "Chatter",
                "accentColor": "#168657",
                "conversationsObjectApiName": "Communication_Records__c",
                "messagesObjectApiName": "Communication_Records__c",
                "channelAccountObjectApiName": "Connector_App__c",
                "restrictToAssigned": true,
                "enableAssignment": true,
                "actionFlows": {
                  "send": {
                    "flowApiName": "CHATTER_SEND_MESSAGE",
                    "inputs": {
                      "ConversationId": "$event.conversationId",
                      "ChannelAccountId": "$event.channelAccountId",
                      "RecipientPhone": "$event.recipientPhone",
                      "Body": "$event.body"
                    }
                  },
                  "assign": {
                    "flowApiName": "CHATTER_ASSIGN_CONVERSATION",
                    "inputs": {
                      "ConversationId": "$event.conversationId",
                      "ChannelAccountId": "$event.channelAccountId",
                      "AssigneeId": "$event.assigneeId"
                    }
                  }
                },
                "objectApiName": "Communication_Records__c",
                "recordPresenterApiName": "CommunicationThread",
                "canSend": false,
                "canAssign": false
              }
            }
          ],
          "activationAssignments": [
            {
              "id": "chatter-communication-org-default",
              "scope": "Org Default",
