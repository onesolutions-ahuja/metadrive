      "pages": [
        {
          "apiName": "UNE_KIOSK",
          "label": "UNE KIOSK",
          "targetObject": "Sale__c",
          "pageType": "Home Page",
          "layoutMode": "free-canvas",
          "canvasWidth": 1080,
          "canvasHeight": 1920,
          "status": "Active",
          "devices": [
            "Desktop",
            "Phone"
          ],
          "template": "header-main-sidebar",
          "components": [
            {
              "id": "kiosk-ordering-experience",
              "type": "Custom:KioskOrderingExperience",
              "label": "Object-bound Ordering Kiosk",
              "region": "main",
              "visible": true,
              "position": {
                "x": 0,
                "y": 0,
                "width": 1080,
                "height": 1920
              },
              "properties": {
                "libraryComponentId": "KioskOrderingExperience",
                "objectApiName": "Product",
                "nameField": "Name",
                "priceField": "DefaultPrice",
                "imageField": "ImageUrl__c",
                "categoryField": "CategoryId",
                "descriptionField": "Description__c",
                "filters": [
                  {
                    "field": "IsActive",
                    "operator": "Equals",
                    "value": "true"
                  }
                ],
                "cartObjectApiName": "CartLine__c",
                "cartSessionField": "Session__c",
                "cartProductField": "Product__c",
                "cartQuantityField": "Quantity__c",
                "cartPriceField": "Unit_Price__c",
                "actionFlows": {
                  "add": {
                    "flowApiName": "KIOSK_CART_ADD",
                    "inputs": {
                      "SessionId": "$session",
                      "ProductId": "$event.productId",
                      "Quantity": "$event.quantity"
                    }
                  },
                  "quantity": {
                    "flowApiName": "KIOSK_CART_QUANTITY",
                    "inputs": {
                      "SessionId": "$session",
                      "LineId": "$event.lineId",
                      "Quantity": "$event.quantity"
                    }
                  },
                  "remove": {
                    "flowApiName": "KIOSK_CART_REMOVE",
                    "inputs": {
                      "SessionId": "$session",
                      "LineId": "$event.lineId"
                    }
                  },
                  "reset": {
                    "flowApiName": "KIOSK_CART_RESET",
                    "inputs": {
                      "SessionId": "$session"
                    },
                    "resetSessionOnSuccess": true
                  },
                  "start": {
                    "flowApiName": "KIOSK_SESSION_START",
                    "inputs": {
                      "SessionId": "$session"
                    }
                  },
                  "checkout": {
                    "flowApiName": "KIOSK_CHECKOUT",
                    "inputs": {
                      "SessionId": "$session",
                      "OrderType": "$event.orderType"
                    }
                  }
                },
                "brandName": "Your Restaurant",
                "tagline": "Made fresh for you",
                "accentColor": "#ffca26",
                "inkColor": "#202124",
                "currency": "£",
                "language": "English",
                "heroTitle": "Big flavour. Great food.",
                "heroSubtitle": "Choose your favourites, customise and enjoy.",
                "menuTitle": "What are you craving?"
              }
            }
          ]
        }
