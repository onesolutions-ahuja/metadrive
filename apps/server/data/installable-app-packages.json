              "recordTypeId": null,
              "formFactors": [
                "Desktop",
                "Phone"
              ]
            }
          ]
        }
      ],
      "flows": [
        {
          "apiName": "CHATTER_SEND_MESSAGE",
          "label": "Chatter Send WhatsApp Message",
          "description": "Admin-controlled trusted WhatsApp account credential, HTTP Callout and outgoing Communication record; credentials supplied only after server channel authorisation",
          "flowType": "Autolaunched Flow",
          "status": "Active",
          "versionNumber": 1,
          "activeVersion": 1,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Start",
              "config": {}
            },
            {
              "id": 2,
              "type": "HTTP Callout",
              "label": "Send via authorised WhatsApp account",
              "config": {
                "namedCredentialResource": "{!AuthorisedCredentialId}",
                "method": "POST",
                "path": "messages",
                "headers": "Content-Type: application/json",
                "body": "{\"messaging_product\":\"whatsapp\",\"to\":\"{!RecipientPhone}\",\"type\":\"text\",\"text\":{\"body\":\"{!Body}\"}}",
                "deliveryMode": "SYNC",
                "onError": "FAIL",
                "statusVariable": "ProviderStatus"
              }
            },
            {
              "id": 3,
              "type": "Create Records",
              "label": "Log outgoing message",
              "config": {
                "object": "Communication_Records__c",
                "fieldValues": [
                  {
                    "field": "Event_Type__c",
                    "value": "Message"
                  },
                  {
                    "field": "Communication_Mode__c",
                    "value": "WhatsApp"
                  },
                  {
                    "field": "Source__c",
                    "value": "Flow"
                  },
                  {
                    "field": "Direction__c",
                    "value": "Outgoing"
                  },
                  {
                    "field": "Channel_Account__c",
                    "value": "{!ChannelAccountId}"
                  },
                  {
                    "field": "From_Number__c",
                    "value": "{!SenderPhone}"
                  },
                  {
                    "field": "To_Number__c",
                    "value": "{!RecipientPhone}"
                  },
                  {
                    "field": "Assigned_User__c",
                    "value": "{!AssignedUserId}"
                  },
                  {
                    "field": "Message_Body__c",
                    "value": "{!Body}"
                  },
                  {
                    "field": "Status__c",
                    "value": "Sent"
                  }
                ]
              }
            },
            {
              "id": 4,
              "type": "End",
              "label": "End",
              "config": {}
            }
          ],
          "connectors": [
            {
              "id": "start_send",
              "from": 1,
              "to": 2,
              "kind": "normal",
              "label": ""
            },
            {
              "id": "send_log",
              "from": 2,
              "to": 3,
              "kind": "normal",
              "label": ""
            },
            {
              "id": "log_end",
              "from": 3,
              "to": 4,
              "kind": "normal",
              "label": ""
            }
          ],
