        {
          "apiName": "CHATTER_ASSIGN_CONVERSATION",
          "label": "Chatter Assign Conversation",
          "description": "Updates trusted latest conversation record using a server-authorised target and assignee",
          "flowType": "Autolaunched Flow",
          "status": "Active",
          "versionNumber": 1,
          "activeVersion": 1,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Start",
              "config": {}
            },
            {
              "id": 2,
              "type": "Update Records",
              "label": "Assign authorised conversation",
              "config": {
                "object": "Communication_Records__c",
                "conditions": [
                  {
                    "field": "Id",
                    "operator": "Equals",
                    "value": "{!TargetRecordId}"
                  }
                ],
                "fieldValues": [
                  {
                    "field": "Assigned_User__c",
                    "value": "{!AssigneeId}"
                  }
                ]
              }
            },
            {
              "id": 3,
              "type": "End",
              "label": "End",
              "config": {}
            }
          ],
