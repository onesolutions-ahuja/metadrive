              "availableForInput": false,
              "availableForOutput": false
            }
          ],
          "versions": []
        },
        {
          "apiName": "KIOSK_CART_ADD",
          "label": "Kiosk - Add product",
          "description": "Editable metadata Flow; uses record permissions and tenant objects",
          "flowType": "Autolaunched Flow",
          "status": "Active",
          "versionNumber": 1,
          "activeVersion": null,
          "triggerObject": null,
          "startConfig": {},
          "elements": [
            {
              "id": 1,
              "type": "Start",
              "label": "Add",
              "config": {}
            },
            {
              "id": 2,
              "type": "Get Records",
              "label": "Read current product and price",
              "config": {
                "object": "Product",
                "conditions": [
                  {
                    "field": "Id",
                    "operator": "Equals",
                    "value": "{!ProductId}"
                  },
                  {
                    "field": "IsActive",
                    "operator": "Equals",
                    "value": true
                  }
                ],
                "outputVariable": "SelectedProduct"
              }
            },
            {
              "id": 3,
              "type": "Decision",
              "label": "Product exists?",
              "config": {
                "outcomes": [
                  {
                    "name": "Found",
                    "label": "Found",
                    "conditions": [
                      {
                        "field": "{!SelectedProduct.Id}",
                        "operator": "Is Not Null"
                      },
                      {
                        "field": "{!Quantity}",
                        "operator": "Greater Than",
                        "value": 0
                      }
                    ]
                  },
                  {
                    "name": "Default",
                    "label": "Default Outcome",
                    "conditions": []
                  }
                ]
              }
            },
            {
              "id": 4,
              "type": "Create Records",
              "label": "Create cart line",
              "config": {
                "object": "CartLine__c",
                "fieldValues": [
                  {
                    "field": "Name",
                    "value": "{!SelectedProduct.Name}"
                  },
                  {
                    "field": "Session__c",
                    "value": "{!SessionId}"
                  },
                  {
                    "field": "Product",
                    "value": "{!ProductId}"
                  },
                  {
                    "field": "Quantity__c",
                    "value": "{!Quantity}"
                  },
                  {
                    "field": "Unit_DefaultPrice",
                    "value": "{!SelectedProduct.DefaultPrice}"
                  }
                ]
              }
            },
            {
              "id": 5,
              "type": "End",
              "label": "End",
              "config": {}
            }
          ],
