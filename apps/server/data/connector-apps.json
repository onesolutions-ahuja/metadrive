  "flows": [
    {
      "apiName": "ONE_Install_Connector",
      "label": "ONE – Install Connector",
      "description": "Metadata-driven connector lifecycle. Uses standard Update Records and server-enforced entitlement invariants.",
      "flowType": "Autolaunched Flow",
      "status": "Active",
      "versionNumber": 1,
      "activeVersion": 1,
      "triggerObject": null,
      "startConfig": {},
      "elements": [
        {
          "id": 1,
          "type": "Start",
          "label": "Start",
          "config": {}
        },
        {
          "id": 2,
          "type": "Update Records",
          "label": "Update Connector App",
          "config": {
            "object": "Connector_App__c",
            "conditions": [
              {
                "field": "AppKey__c",
                "operator": "Equals",
                "value": "{!AppKey}"
              }
            ],
            "fieldValues": [
              {
                "field": "Installed__c",
                "value": true
              }
            ]
          }
        },
        {
          "id": 3,
          "type": "End",
          "label": "End",
          "config": {}
        }
      ],
      "connectors": [
        {
          "id": "connector-1",
          "from": 1,
          "to": 2,
          "label": "",
          "kind": "normal"
        },
        {
          "id": "connector-2",
          "from": 2,
          "to": 3,
          "label": "",
          "kind": "normal"
        }
      ],
      "resources": [
