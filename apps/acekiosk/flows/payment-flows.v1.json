                {
                  "field": "{!itemCount}",
                  "operator": "GreaterThan",
                  "value": 0
                },
                {
                  "field": "{!cardPaymentConfirmed}",
                  "operator": "Equals",
                  "value": true
                },
                {
                  "field": "{!cartTotal}",
                  "operator": "Equals",
                  "value": "{!validatedTotal}"
                }
              ],
              "label": "Approved",
              "name": "Approved"
            }
          ]
        },
        "id": 10,
        "label": "Validate tender and nonempty cart",
        "type": "Decision"
      },
      {
        "config": {
          "errorLocation": "Page",
          "errorMessage": "Basket total differs from current Product prices, the cash tender is insufficient, or card confirmation is missing. Refresh the basket; no sale was saved."
        },
        "id": 11,
        "label": "Invalid payment",
        "type": "Custom Error"
      },
      {
        "config": {
          "fieldValues": [
            {
              "field": "Name",
              "value": "AceKiosk Order"
            },
            {
              "field": "Total",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Subtotal",
              "value": "{!validatedTotal}"
            },
            {
              "field": "PaymentMethod",
              "value": "Card"
            },
            {
              "field": "PaymentStatus",
              "value": "Paid"
            },
            {
              "field": "PaymentRequestId",
              "value": "{!requestId}"
            }
          ],
          "object": "Order",
          "recordSource": "fields"
        },
        "id": 12,
        "label": "Create settled Order",
        "type": "Create Records"
      },
      {
        "config": {
          "collection": "cartItems",
          "direction": "First to last",
          "loopVariable": "saveLine"
        },
        "id": 13,
        "label": "Save each order line",
        "type": "Loop"
      },
      {
        "config": {
          "conditionLogic": "All",
          "conditions": [
            {
              "field": "Id",
              "operator": "Equals",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Active",
              "operator": "Equals",
              "value": true
            }
          ],
          "object": "Product",
          "outputVariable": "currentProduct",
          "recordLimit": "1"
        },
        "id": 14,
        "label": "Read Product for order line",
        "type": "Get Records"
      },
      {
        "config": {
          "fieldValues": [
            {
              "field": "Order",
              "value": "{!record12.Id}"
            },
            {
              "field": "Product",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Quantity",
              "value": "{!saveLine.Quantity}"
            },
            {
              "field": "UnitPrice",
              "value": "{!currentProduct.Price}"
            },
            {
              "field": "LineTotal",
              "value": "{!saveLineAmount}"
            }
          ],
          "object": "OrderLine",
          "recordSource": "fields"
        },
        "id": 15,
        "label": "Create OrderLine using trusted price",
        "type": "Create Records"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "{!record12.Id}",
          "variable": "orderId"
        },
        "id": 16,
        "label": "Return saved order ID",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "completed",
          "variable": "status"
        },
        "id": 17,
        "label": "Mark completed",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "{!validatedTotal}",
          "variable": "total"
        },
        "id": 18,
        "label": "Return verified total",
        "type": "Assignment"
      },
      {
        "config": {},
        "id": 19,
        "label": "End",
        "type": "End"
      },
      {
        "id": 20,
        "type": "Assignment",
        "label": "Initialize saved line total",
        "config": {
          "variable": "secondTotal",
          "operator": "Assign",
          "value": 0
        }
      },
      {
        "id": 21,
        "type": "Assignment",
        "label": "Accumulate saved line amount",
        "config": {
          "variable": "secondTotal",
          "operator": "Add",
          "value": "{!saveLineAmount}"
        }
      },
      {
        "id": 22,
        "type": "Decision",
        "label": "Verify order and line totals",
        "config": {
          "outcomes": [
            {
              "name": "Match",
              "label": "Match",
              "conditions": [
                {
                  "field": "{!secondTotal}",
                  "operator": "Equals",
                  "value": "{!validatedTotal}"
                }
              ],
              "conditionLogic": "All"
            }
          ]
        }
      },
      {
        "id": 23,
        "type": "Custom Error",
        "label": "Reject price changes",
        "config": {
          "errorLocation": "Page",
          "errorMessage": "Product price changed during checkout; no sale was recorded. Please try again."
        }
      },
      {
        "id": 24,
        "label": "Create settled financial Invoice",
        "type": "Create Records",
        "config": {
          "object": "Invoice",
          "recordSource": "fields",
          "fieldValues": [
            {
              "field": "Name",
              "value": "AceKiosk Invoice"
            },
            {
              "field": "Subtotal",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Total",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Status",
              "value": "Paid"
            },
            {
              "field": "Checkout_Request_ID__c",
              "value": "{!requestId}"
            },
            {
              "field": "Payment_Method__c",
              "value": "Card"
            },
            {
              "field": "Order",
              "value": "{!record12.Id}"
            }
          ]
        }
      },
      {
        "id": 25,
        "label": "Create financial InvoiceLine using trusted price",
        "type": "Create Records",
        "config": {
          "object": "InvoiceLine",
          "recordSource": "fields",
          "fieldValues": [
            {
              "field": "Invoice",
              "value": "{!record24.Id}"
            },
            {
              "field": "Product",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Quantity",
              "value": "{!saveLine.Quantity}"
            },
            {
              "field": "UnitPrice",
              "value": "{!currentProduct.Price}"
            },
            {
              "field": "LineTotal",
              "value": "{!saveLineAmount}"
            }
          ]
        }
      },
      {
        "id": 26,
        "label": "Return financial Invoice ID",
        "type": "Assignment",
        "config": {
          "variable": "invoiceId",
          "operator": "Assign",
          "value": "{!record24.Id}"
        }
      }
    ],
