        "value": "cashReceived - validatedTotal"
      },
      {
        "availableForOutput": true,
        "dataType": "Text",
        "name": "orderId",
        "type": "Variable"
      },
      {
        "availableForOutput": true,
        "dataType": "Text",
        "name": "status",
        "type": "Variable"
      },
      {
        "availableForOutput": true,
        "dataType": "Number",
        "name": "total",
        "type": "Variable"
      },
      {
        "name": "secondTotal",
        "type": "Variable",
        "dataType": "Number"
      },
      {
        "name": "verifyLineAmount",
        "type": "Formula",
        "dataType": "Number",
        "value": "currentProduct.Price * verifyLine.Quantity"
      },
      {
        "name": "saveLineAmount",
        "type": "Formula",
        "dataType": "Number",
        "value": "currentProduct.Price * saveLine.Quantity"
      },
      {
        "name": "invoiceId",
        "type": "Variable",
        "dataType": "Text",
        "availableForOutput": true
      }
    ],
