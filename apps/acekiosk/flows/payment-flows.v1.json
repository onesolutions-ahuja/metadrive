        },
        "id": 1,
        "label": "Start",
        "type": "Start"
      },
      {
        "config": {
          "operator": "Assign",
          "value": 0,
          "variable": "validatedTotal"
        },
        "id": 2,
        "label": "Initialize verified totals",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Assign",
          "value": 0,
          "variable": "itemCount"
        },
        "id": 3,
        "label": "Initialize item count",
        "type": "Assignment"
      },
      {
        "config": {
          "collection": "cartItems",
          "direction": "First to last",
          "loopVariable": "verifyLine"
        },
        "id": 4,
        "label": "Verify each cart item",
        "type": "Loop"
      },
      {
        "config": {
          "conditionLogic": "All",
          "conditions": [
            {
              "field": "Id",
              "operator": "Equals",
              "value": "{!verifyLine.Product}"
            },
            {
              "field": "Active",
              "operator": "Equals",
              "value": true
            }
          ],
          "object": "Product",
          "outputVariable": "currentProduct",
          "recordLimit": "1"
        },
        "id": 5,
        "label": "Retrieve authoritative Product price",
        "type": "Get Records"
      },
      {
        "config": {
          "outcomes": [
            {
              "conditionLogic": "All",
              "conditions": [
                {
                  "field": "{!currentProduct}",
                  "operator": "IsNotNull"
                },
                {
                  "field": "{!verifyLine.Quantity}",
                  "operator": "GreaterThan",
                  "value": 0
                },
                {
                  "field": "{!currentProduct.Price}",
                  "operator": "GreaterThanOrEqualTo",
                  "value": 0
                }
              ],
              "label": "Valid",
              "name": "Valid"
            }
          ]
        },
        "id": 6,
        "label": "Valid price and quantity",
        "type": "Decision"
      },
      {
        "config": {
          "operator": "Add",
          "value": "{!verifyLineAmount}",
          "variable": "validatedTotal"
        },
        "id": 7,
        "label": "Accumulate trusted amount",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Add",
          "value": 1,
          "variable": "itemCount"
        },
        "id": 8,
        "label": "Count item",
        "type": "Assignment"
      },
      {
        "config": {
          "errorLocation": "Page",
          "errorMessage": "A cart item is inactive, unavailable, or has an invalid quantity/price. No sale was saved."
        },
        "id": 9,
        "label": "Invalid product or quantity",
        "type": "Custom Error"
      },
      {
        "config": {
          "outcomes": [
            {
              "conditionLogic": "All",
              "conditions": [
                {
                  "field": "{!itemCount}",
                  "operator": "GreaterThan",
                  "value": 0
                },
                {
                  "field": "{!cashReceived}",
                  "operator": "GreaterThanOrEqualTo",
                  "value": "{!validatedTotal}"
                },
                {
                  "field": "{!cartTotal}",
                  "operator": "Equals",
                  "value": "{!validatedTotal}"
                }
              ],
              "label": "Approved",
              "name": "Approved"
            }
          ]
        },
        "id": 10,
        "label": "Validate tender and nonempty cart",
        "type": "Decision"
      },
      {
        "config": {
          "errorLocation": "Page",
          "errorMessage": "Basket total differs from current Product prices, the cash tender is insufficient, or card confirmation is missing. Refresh the basket; no sale was saved."
        },
        "id": 11,
        "label": "Invalid payment",
        "type": "Custom Error"
      },
      {
        "config": {
          "fieldValues": [
            {
              "field": "Name",
              "value": "AceKiosk Order"
            },
            {
              "field": "Total",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Subtotal",
              "value": "{!validatedTotal}"
            },
            {
              "field": "PaymentMethod",
              "value": "Cash"
            },
            {
              "field": "PaymentStatus",
              "value": "Paid"
            },
            {
              "field": "PaymentRequestId",
              "value": "{!requestId}"
            },
            {
              "field": "CashReceived",
              "value": "{!cashReceived}"
            },
            {
              "field": "ChangeDue",
              "value": "{!changeAmount}"
            }
          ],
          "object": "Order",
          "recordSource": "fields"
        },
        "id": 12,
        "label": "Create settled Order",
        "type": "Create Records"
      },
      {
        "config": {
          "collection": "cartItems",
          "direction": "First to last",
          "loopVariable": "saveLine"
        },
        "id": 13,
        "label": "Save each order line",
        "type": "Loop"
      },
      {
        "config": {
          "conditionLogic": "All",
          "conditions": [
            {
              "field": "Id",
              "operator": "Equals",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Active",
              "operator": "Equals",
              "value": true
            }
          ],
          "object": "Product",
          "outputVariable": "currentProduct",
          "recordLimit": "1"
        },
        "id": 14,
        "label": "Read Product for order line",
        "type": "Get Records"
      },
      {
        "config": {
          "fieldValues": [
            {
              "field": "Order",
              "value": "{!record12.Id}"
            },
            {
              "field": "Product",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Quantity",
              "value": "{!saveLine.Quantity}"
            },
            {
              "field": "UnitPrice",
              "value": "{!currentProduct.Price}"
            },
            {
              "field": "LineTotal",
              "value": "{!saveLineAmount}"
            }
          ],
          "object": "OrderLine",
          "recordSource": "fields"
        },
        "id": 15,
        "label": "Create OrderLine using trusted price",
        "type": "Create Records"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "{!record12.Id}",
          "variable": "orderId"
        },
        "id": 16,
        "label": "Return saved order ID",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "completed",
          "variable": "status"
        },
        "id": 17,
        "label": "Mark completed",
        "type": "Assignment"
      },
      {
        "config": {
          "operator": "Assign",
          "value": "{!validatedTotal}",
          "variable": "total"
        },
        "id": 18,
        "label": "Return verified total",
        "type": "Assignment"
      },
      {
        "config": {},
        "id": 19,
        "label": "End",
        "type": "End"
      },
      {
        "id": 20,
        "type": "Assignment",
        "label": "Initialize saved line total",
        "config": {
          "variable": "secondTotal",
          "operator": "Assign",
          "value": 0
        }
      },
      {
        "id": 21,
        "type": "Assignment",
        "label": "Accumulate saved line amount",
        "config": {
          "variable": "secondTotal",
          "operator": "Add",
          "value": "{!saveLineAmount}"
        }
      },
      {
        "id": 22,
        "type": "Decision",
        "label": "Verify order and line totals",
        "config": {
          "outcomes": [
            {
              "name": "Match",
              "label": "Match",
              "conditions": [
                {
                  "field": "{!secondTotal}",
                  "operator": "Equals",
                  "value": "{!validatedTotal}"
                }
              ],
              "conditionLogic": "All"
            }
          ]
        }
      },
      {
        "id": 23,
        "type": "Custom Error",
        "label": "Reject price changes",
        "config": {
          "errorLocation": "Page",
          "errorMessage": "Product price changed during checkout; no sale was recorded. Please try again."
        }
      },
      {
        "id": 24,
        "label": "Create settled financial Invoice",
        "type": "Create Records",
        "config": {
          "object": "Invoice",
          "recordSource": "fields",
          "fieldValues": [
            {
              "field": "Name",
              "value": "AceKiosk Invoice"
            },
            {
              "field": "Subtotal",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Total",
              "value": "{!validatedTotal}"
            },
            {
              "field": "Status",
              "value": "Paid"
            },
            {
              "field": "Checkout_Request_ID__c",
              "value": "{!requestId}"
            },
            {
              "field": "Payment_Method__c",
              "value": "Cash"
            },
            {
              "field": "Order",
              "value": "{!record12.Id}"
            }
          ]
        }
      },
      {
        "id": 25,
        "label": "Create financial InvoiceLine using trusted price",
        "type": "Create Records",
        "config": {
          "object": "InvoiceLine",
          "recordSource": "fields",
          "fieldValues": [
            {
              "field": "Invoice",
              "value": "{!record24.Id}"
            },
            {
              "field": "Product",
              "value": "{!saveLine.Product}"
            },
            {
              "field": "Quantity",
              "value": "{!saveLine.Quantity}"
            },
            {
              "field": "UnitPrice",
              "value": "{!currentProduct.Price}"
            },
            {
              "field": "LineTotal",
              "value": "{!saveLineAmount}"
            }
          ]
        }
      },
      {
        "id": 26,
        "label": "Return financial Invoice ID",
        "type": "Assignment",
        "config": {
          "variable": "invoiceId",
          "operator": "Assign",
          "value": "{!record24.Id}"
        }
      }
    ],
    "flowType": "Autolaunched Flow",
    "label": "AceKiosk Payment Cash",
    "resources": [
      {
        "availableForInput": true,
        "dataType": "OrderLine",
        "isCollection": true,
