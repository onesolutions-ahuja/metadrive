{
  "name": "metadrive-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/server",
    "test": "npm run test:unit",
    "test:unit": "npm run test:system --workspace apps/server",
    "check": "node scripts/verify-project-references.mjs && npm run test:unit && npm run build && node apps/web/src/shared/verify-lazy-bundle.mjs apps/web/dist",
    "start:web": "npm run preview --workspace apps/web",
    "start:server": "npm run start --workspace apps/server",
    "audit:architecture": "node scripts/verify-project-references.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.2"
  }
}
