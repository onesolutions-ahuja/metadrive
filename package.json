{
  "name": "metadrive-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prebuild": "npm run test:canvas",
    "test:canvas": "tsx --test scripts/md10-modern-canvas.test.mjs",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run test:foundation && npm run test:page-routing && npm run test:route-directory && npm run test:flow-binding && npm run test:record-filter && npm run test:visibility && npm run test:component-metadata && npm run test:modern-canvas && npm run test:flow-canvas && npm run test:flow-connectors && npm run test:flow-screen-upload && npm run test:flow-screen-datatable && npm run build --workspace apps/web && npm run build --workspace apps/server",
    "start:web": "npm run preview --workspace apps/web",
    "start:server": "npm run start --workspace apps/server",
    "test:foundation": "node --test scripts/foundation-contract.test.mjs",
    "test:foundation:live": "node scripts/foundation-live-smoke.mjs",
    "test:page-routing": "node --experimental-strip-types --test scripts/page-action-routing.test.mjs",
    "test:flow-binding": "node --experimental-strip-types --test scripts/md09-flow-input-bindings.test.mjs",
    "test:record-filter": "node --experimental-strip-types --test scripts/md09-record-filter-metadata.test.mjs",
    "test:visibility": "tsx --test scripts/md09-component-visibility.test.mjs",
    "test:route-directory": "tsx --test scripts/md09-route-directory.test.mjs",
    "test:component-metadata": "tsx --test scripts/md10-universal-component-metadata.test.mjs",
    "test:flow-canvas": "node --test scripts/md10-freeform-canvas.test.mjs",
    "test:flow-connectors": "node --test scripts/md10-flow-connector-insertion.test.mjs apps/web/test/flow-insert-element.test.mjs",
    "test:flow-screen-upload": "node --test scripts/md10-flow-screen-upload.test.mjs",
    "test:flow-screen-datatable": "node --test scripts/md10-flow-screen-datatable.test.mjs",
    "test:modern-canvas": "tsx --test scripts/md10-modern-canvas-contract.test.mjs"
  }
}
